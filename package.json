{
  "name": "portfolio",
  "description": "Portfolio site for Shahabedin Malek",
  "repository": "https://github.com/shahabedin-malek/react-portfolio/",
  "author": "Shahabedin Malek",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "build:github": "DEPLOY_TARGET=github-pages npm run build",
    "export:github": "DEPLOY_TARGET=github-pages npm run build && DEPLOY_TARGET=github-pages node ./scripts/export-github.cjs",
    "export:vercel": "npm run build && SITE_ORIGIN=https://shahabedin-malek.vercel.app node ./scripts/export-github.cjs",
    "dev": "node ./scripts/dev.cjs && remix vite:dev",
    "start": "wrangler pages dev ./build/client",
    "postinstall": "node ./scripts/draco.cjs",
    "deploy": "npm run build && wrangler pages deploy ./build/client --project-name portfolio"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.515.0",
    "@mdx-js/react": "^3.0.1",
    "@remix-run/cloudflare": "^2.7.1",
    "@remix-run/cloudflare-pages": "^2.7.1",
    "@remix-run/react": "^2.7.1",
    "framer-motion": "11.0.5",
    "gsap": "^3.15.0",
    "isbot": "^4.1.0",
    "miniflare": "^3.20231030.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rehype-img-size": "^1.0.1",
    "rehype-slug": "^6.0.0",
    "three": "^0.161.0",
    "three-stdlib": "^2.29.4"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^2.1.1",
    "@mapbox/rehype-prism": "^0.9.0",
    "@mdx-js/rollup": "^3.0.1",
    "@remix-run/dev": "^2.7.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.4.33",
    "postcss-custom-media": "^10.0.2",
    "prop-types": "^15.8.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^4.0.0",
    "vite": "^5.1.0",
    "vite-jsconfig-paths": "^2.0.1",
    "wrangler": "^3.24.0"
  },
  "engines": {
    "node": ">=19.9.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.17.6": true,
    "esbuild@0.21.5": true,
    "esbuild@0.17.19": true,
    "sharp@0.33.5": true,
    "workerd@1.20250718.0": true
  }
}
